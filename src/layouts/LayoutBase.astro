---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'The Overtime Archive', description = 'Ein transmediales Archiv menschlicher Zivilisation. 60.000 BCE – 2500 CE.' } = Astro.props;
const epigraphs = [
  { text: 'Das Archiv lügt nicht. Es schweigt nur an den falschen Stellen.', cite: 'T.P.Küper, KN-0.1' },
  { text: 'Materie bewahrt, was Wissen verliert.', cite: 'OTA-FND-0026' },
  { text: 'Genesis vor Narration. Immer.', cite: 'Grundprinzip des OTA' },
  { text: 'Die Stille begann am 8. Juni 2087. Dauer: 42 Tage, 12 Stunden.', cite: 'OTA-HIS-0003' },
  { text: 'Das Archiv dokumentiert. Es spekuliert nicht.', cite: 'OTA-ARC-0001' },
  { text: 'Resonanz ist kein Zufall. Sie ist Selektion.', cite: 'OTA-FND-0003' },
];
const epigraph = epigraphs[Math.floor(Math.random() * epigraphs.length)];
const sidebarNav = [
  { label: 'Startseite', labelEN: 'Home', href: '/', icon: '⌂' }, { label: 'Katalog', labelEN: 'Catalogue', href: '/katalog', icon: '◫' },
  { label: 'Serien', labelEN: 'Series', href: '/serien', icon: '≡' }, { label: 'Suche', labelEN: 'Search', href: '/suche', icon: '⌕' },
  { label: 'Quellen', labelEN: 'Sources', href: '/quellen', icon: '◐' }, { label: 'Kurator', labelEN: 'Curator', href: '/kurator', icon: '◎' },
  { label: 'Über das Archiv', labelEN: 'About', href: '/ueber', icon: 'ℹ' }, { label: 'Impressum', labelEN: 'Legal', href: '/impressum', icon: '§' },
];
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html><html lang="de" id="html-root"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={description}/><title>{title} · The Overtime Archive</title></head><body>
<div id="terminal-intro" aria-hidden="true"><div class="terminal-window"><div class="terminal-titlebar"><span style="width:8px;height:8px;border-radius:50%;background:#B0302A;display:inline-block"></span><span style="width:8px;height:8px;border-radius:50%;background:#C8923A;display:inline-block;margin:0 4px"></span><span style="width:8px;height:8px;border-radius:50%;background:#3D7A5A;display:inline-block"></span><span style="margin-left:1rem">OTA-ARCHIVE-ACCESS v0.92a</span><span style="margin-left:auto">overtimearchive.org</span></div><div class="terminal-body" id="terminal-body"></div></div></div>
<header class="site-header"><a href="/" class="header-logo" aria-label="The Overtime Archive — Startseite"><div class="logo-svg-wrap"><svg width="56" height="56" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg"><g class="logo-ring-outer"><circle cx="60" cy="60" r="55" stroke="currentColor" stroke-width="1.4"/><circle cx="60" cy="5" r="2" fill="currentColor" opacity="0.45"/><circle cx="60" cy="115" r="2" fill="currentColor" opacity="0.45"/></g><g class="logo-hourglass"><polygon points="60,32 43,52 77,52" fill="none" stroke="currentColor" stroke-width="2"/><polygon points="60,88 43,68 77,68" fill="none" stroke="currentColor" stroke-width="2"/><line x1="43" y1="52" x2="43" y2="68" stroke="currentColor" stroke-width="2"/><line x1="77" y1="52" x2="77" y2="68" stroke="currentColor" stroke-width="2"/></g><circle cx="60" cy="60" r="2" fill="currentColor"/></svg></div><div class="header-logo-text"><span class="line1">THE OVERTIME ARCHIVE</span><span class="line2">CURATED BY · SOLAR SCIENCE FOUNDATION</span></div></a>
<div class="header-right"><div class="header-status"><span class="status-dot"></span><span data-de="SYSTEM ONLINE" data-en="SYSTEM ONLINE">SYSTEM ONLINE</span><span style="margin-left:0.6rem" data-de="PUBLIC ACCESS" data-en="PUBLIC ACCESS">PUBLIC ACCESS</span></div><a class="header-search" href="/suche" data-de="SUCHE" data-en="SEARCH" aria-label="Archiv durchsuchen">SUCHE</a><div class="lang-toggle" role="group" aria-label="Sprache / Language"><button class="lang-btn active" id="lang-de" onclick="setLang('de')">DE</button><button class="lang-btn" id="lang-en" onclick="setLang('en')">EN</button></div></div></header>
<div class="app-body"><aside class="sidebar" aria-label="Navigation"><div class="sidebar-section"><div class="sidebar-label" data-de="Navigation" data-en="Navigation">Navigation</div><ul class="sidebar-nav">{sidebarNav.map(item => <li><a href={item.href} class:list={[{ active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]} data-de={item.label} data-en={item.labelEN}><span class="icon">{item.icon}</span>{item.label}</a></li>)}</ul></div><div class="sidebar-section"><div class="sidebar-label" data-de="Zufallsdokument" data-en="Random Access">Zufallsdokument</div><button class="random-btn" id="random-access-btn" aria-label="Zufälliges Dokument öffnen">RANDOM_ACCESS</button></div><div class="sidebar-section"><div class="sidebar-label" data-de="Zuletzt geöffnet" data-en="Recently viewed">Zuletzt geöffnet</div><div class="sidebar-recent" id="sidebar-recent"><div class="sidebar-empty">— noch keine Einträge —</div></div></div><div class="sidebar-section"><div class="sidebar-label" data-de="Arbeitsmappe" data-en="Bookmarks">Arbeitsmappe</div><div class="sidebar-bookmarks" id="sidebar-bookmarks"><div class="sidebar-empty">— keine Lesezeichen —</div></div></div><div class="sidebar-institution"><span>CURATED BY</span><strong>SOLAR SCIENCE FOUNDATION</strong><small>KNOWLEDGE PRESERVATION · PUBLIC SCIENCE</small></div></aside><main class="main-content" id="main-content"><slot /></main></div>
<footer class="site-footer"><div class="footer-left"><div class="brand">THE OVERTIME ARCHIVE</div><div class="footer-curation">CURATED BY · SOLAR SCIENCE FOUNDATION</div><div style="color:rgba(220,228,235,0.45)">overtimearchive.org · ARCHIVE NODE · PUBLIC ACCESS</div><div class="footer-links"><a href="/ueber">Über das Archiv</a><a href="/protokolle">Protokolle</a><a href="/impressum">Impressum & Datenschutz</a><a href="/kontakt">Kontakt</a></div></div><div class="footer-epigraph"><p>„{epigraph.text}"</p><cite>— {epigraph.cite}</cite></div></footer></body></html>
<script>
(function(){const intro=document.getElementById('terminal-intro'),body=document.getElementById('terminal-body');if(!intro||!body)return;if(sessionStorage.getItem('ota-intro-seen')){intro.style.display='none';return}document.body.style.overflow='hidden';const lines=[{t:'> CONNECTING TO OTA-ARCHIVE NODE 07...',c:'prompt',d:0},{t:'  HANDSHAKE OK · SSL/ARCHIV-CERT v4.1',c:'output',d:520},{t:'> LOADING DOCUMENT INDEX...',c:'prompt',d:1000},{t:'  237 DOKUMENTE GEFUNDEN',c:'output',d:1550},{t:'> TEMPORALE SPANNE: ~60.000 BCE — 2500 CE',c:'output',d:2200},{t:'> INITIALISIERUNG ABGESCHLOSSEN.',c:'success',d:2800},{t:'  WILLKOMMEN IM ARCHIV._',c:'success',d:3300}];lines.forEach(({t,c,d})=>setTimeout(()=>{const el=document.createElement('div');el.className=`terminal-line ${c}`;el.style.opacity='1';body.appendChild(el);let i=0;const iv=setInterval(()=>{el.textContent+=t[i]||'';i++;if(i>=t.length)clearInterval(iv)},16)},d));setTimeout(()=>{intro.style.transition='opacity .6s ease';intro.style.opacity='0';setTimeout(()=>{intro.style.display='none';document.body.style.overflow='';sessionStorage.setItem('ota-intro-seen','1')},600)},4300)})();
function setLang(lang){localStorage.setItem('ota-lang',lang);document.getElementById('lang-de')?.classList.toggle('active',lang==='de');document.getElementById('lang-en')?.classList.toggle('active',lang==='en');document.getElementById('html-root')?.setAttribute('lang',lang);document.querySelectorAll('[data-de][data-en]').forEach(el=>{el.textContent=lang==='en'?el.getAttribute('data-en'):el.getAttribute('data-de')})}(function(){const saved=localStorage.getItem('ota-lang')||'de';if(saved==='en')setLang('en')})();
function getRecent(){try{return JSON.parse(localStorage.getItem('ota-recent')||'[]')}catch{return[]}}function getBookmarks(){try{return JSON.parse(localStorage.getItem('ota-bookmarks')||'[]')}catch{return[]}}function renderSidebarList(containerId,items,emptyDE,emptyEN){const el=document.getElementById(containerId);if(!el)return;const lang=localStorage.getItem('ota-lang')||'de';if(!items.length){el.innerHTML=`<div class="sidebar-empty">${lang==='en'?emptyEN:emptyDE}</div>`;return}el.innerHTML=items.slice(0,5).map(item=>`<div class="sidebar-item"><a href="${item.href}" class="sig">${item.sig}</a><span class="meta">${item.accessed||item.added||''}</span></div>`).join('')}function initSidebar(){renderSidebarList('sidebar-recent',getRecent(),'— noch keine Einträge —','— no entries yet —');renderSidebarList('sidebar-bookmarks',getBookmarks(),'— keine Lesezeichen —','— no bookmarks —')}function trackCurrentPage(){const sig=document.querySelector('[data-signature]')?.getAttribute('data-signature');const title=document.querySelector('[data-doc-title]')?.getAttribute('data-doc-title');if(!sig)return;const recent=getRecent().filter(r=>r.sig!==sig);const now=new Date();recent.unshift({sig,title:title||sig,href:window.location.pathname,accessed:`${now.getDate()}.${now.getMonth()+1}.${now.getFullYear()}`});localStorage.setItem('ota-recent',JSON.stringify(recent.slice(0,10)))}document.getElementById('random-access-btn')?.addEventListener('click',async()=>{try{const res=await fetch('/search-index.json');const docs=await res.json();if(docs.length)window.location.href=docs[Math.floor(Math.random()*docs.length)].url}catch(e){console.error('Random access failed',e)}});document.addEventListener('DOMContentLoaded',()=>{trackCurrentPage();initSidebar()});
</script>
