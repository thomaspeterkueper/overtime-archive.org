---
import LayoutBase from './LayoutBase.astro';
import '../styles/document-v3.css';
import type { CollectionEntry } from 'astro:content';
import type { ResolvedReference } from '../lib/references';

interface QualityProfile {
  extracted?: {
    title?: string | null;
    author?: string | null;
    classification?: string | null;
    excerpt?: string | null;
  };
  quality?: {
    genericTitle?: boolean;
    genericSummary?: boolean;
  };
}

interface Props {
  doc: CollectionEntry<'documents'>;
  relatedDocs?: ResolvedReference[];
  qualityProfile?: QualityProfile | null;
}

const { doc, relatedDocs = [], qualityProfile = null } = Astro.props;
const { signature, title, series, version, year, language, epistemicStatus,
        accessLevel, status, universe, summary, tags } = doc.data;

const relationLabels: Record<string, string> = {
  references: 'Verweist auf',
  basis: 'Grundlage',
  prerequisite: 'Voraussetzung',
  extends: 'Erweitert',
  contradicts: 'Widerspricht',
  supersedes: 'Ersetzt',
  clarifies: 'Klärt',
  related: 'Verwandt',
};

const epistemicLabels: Record<string, string> = {
  R: 'realwissenschaftlich / belegt',
  H: 'Hypothese',
  T: 'theoretisch',
  S: 'spekulativ',
  I: 'Interpretation',
  F: 'fiktional',
  W: 'Werk-Setzung',
  OFFEN: 'offen',
};

const tokenLabels: Record<string, string> = {
  PHYS: 'Physik', THERM: 'Thermodynamik', GEO: 'Geowissenschaften', PLANET: 'Planetologie',
  PHIL: 'Philosophie', SCI: 'Wissenschaftstheorie', BIO: 'Biologie', CHEM: 'Chemie',
  HIST: 'Geschichte', HIS: 'Geschichte', TECH: 'Technologie', TEC: 'Technologie',
  LANG: 'Sprache', LING: 'Linguistik', SOC: 'Gesellschaft', CULT: 'Kultur',
};

function humanDomain(id: string) {
  const core = id.replace(/^KD:/, '').replace(/:N\d+$/, '');
  return core.split('-').map(token => tokenLabels[token] ?? token.charAt(0) + token.slice(1).toLowerCase()).join(' · ');
}

const displayTitle = qualityProfile?.quality?.genericTitle && qualityProfile?.extracted?.title
  ? qualityProfile.extracted.title
  : title;
const author = qualityProfile?.extracted?.author ?? null;
const classification = qualityProfile?.extracted?.classification ?? `${series}-Dokument`;
const isGenericSummary = qualityProfile?.quality?.genericSummary ?? false;
const statusLabel = status === 'AKTIV' ? 'Aktiv' : status.charAt(0) + status.slice(1).toLowerCase();
const visibleRelations = relatedDocs.slice(0, 6);
---

<LayoutBase title={displayTitle} description={summary}>
  <div class="document-v3">
    <aside class="document-v3-context" aria-label="Archivkontext">
      <div>
        <div class="context-kicker">Archivkontext</div>
      </div>

      <section class="context-card">
        <div class="context-label">Einordnung</div>
        <div class="context-value">{classification}</div>
        <span class="context-code">{series} · {year} · {language}</span>
      </section>

      {doc.data.knowledge?.domains && doc.data.knowledge.domains.length > 0 && (
        <section class="context-card">
          <div class="context-label">Wissensdomänen</div>
          <div style="display:grid;gap:0.7rem">
            {doc.data.knowledge.domains.map((domain: any) => (
              <a href={`/suche?domain=${domain.id}`} style="text-decoration:none">
                <span class="context-value">{humanDomain(domain.id)}</span>
                <span class="context-code">{domain.id}{domain.level ? ` · ${domain.level}` : ''}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {universe && universe.length > 0 && (
        <section class="context-card">
          <div class="context-label">Universum / Kontext</div>
          <div class="context-value">{universe.join(' · ')}</div>
        </section>
      )}

      {tags && tags.length > 0 && (
        <section class="context-card">
          <div class="context-label">Schlagworte</div>
          <div class="context-value" style="font-size:0.9rem">{tags.slice(0, 6).join(' · ')}</div>
        </section>
      )}

      <section class="context-card">
        <div class="context-label">Epistemische Einordnung</div>
        <div style="display:grid;gap:0.45rem">
          {epistemicStatus.map(es => (
            <div>
              <span class="context-value">[{es}] {epistemicLabels[es] ?? es}</span>
            </div>
          ))}
        </div>
      </section>

      {visibleRelations.length > 0 && (
        <section class="context-card">
          <div class="context-label">Beziehungen</div>
          <div class="context-relations">
            {visibleRelations.map(rd => rd.slug ? (
              <a class="context-relation" href={`/dokument/${rd.slug}`}>
                <span class="context-relation-kind">{relationLabels[rd.relation] ?? rd.relation}</span>
                <span class="context-relation-title">{rd.title}</span>
                <span class="context-code">{rd.signature}</span>
              </a>
            ) : (
              <div class="context-relation">
                <span class="context-relation-kind">{relationLabels[rd.relation] ?? rd.relation}</span>
                <span class="context-relation-title">{rd.title}</span>
                <span class="context-code">{rd.signature} · {rd.status}</span>
              </div>
            ))}
          </div>
        </section>
      )}
    </aside>

    <article class="document-v3-paper fade-in" data-signature={signature} data-doc-title={displayTitle}>
      <header class="document-v3-head">
        <div class="document-v3-eyebrow">{series} · {classification} · {year}</div>
        <h1 class="document-v3-title">{displayTitle}</h1>
        {author && <div class="document-v3-author">{author}</div>}

        <div class:list={['document-v3-summary', { 'is-generic': isGenericSummary }] }>
          {summary}
          {isGenericSummary && <span class="document-v3-summary-note">Kurzbeschreibung im Bestand · redaktionell zu prüfen</span>}
        </div>

        <div class="document-v3-chips" aria-label="Dokumentmetadaten">
          <span class="document-v3-chip">{year}</span>
          <span class="document-v3-chip">{language}</span>
          <span class="document-v3-chip">{series}</span>
          <span class="document-v3-chip">TIER {accessLevel}</span>
          <span class="document-v3-chip status">{statusLabel}</span>
          {epistemicStatus.map(es => <span class="document-v3-chip epistemic">[{es}]</span>)}
        </div>
        <div class="document-v3-idline">{signature} · {version}</div>

        {visibleRelations.length > 0 && (
          <section class="archive-context" aria-label="Im Archivkontext">
            <div class="archive-context-title">Im Archivkontext</div>
            <div class="archive-context-list">
              {visibleRelations.map(rd => (
                <div class="archive-context-item">
                  <span class="archive-context-kind">{relationLabels[rd.relation] ?? rd.relation}</span>
                  <span>
                    {rd.slug ? <a href={`/dokument/${rd.slug}`}>{rd.title}</a> : rd.title}
                    <span class="context-code" style="display:inline;margin-left:0.45rem">{rd.signature}</span>
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}
      </header>

      <div class="doc-body">
        <slot />
      </div>

      <section class="epistemic-note" aria-label="Epistemische Fußnote">
        <div class="epistemic-note-title">Epistemische Fußnote</div>
        <p>Dieses Dokument verwendet die OTA-Markierungen {epistemicStatus.map(es => `[${es}]`).join(', ')}. {epistemicStatus.map(es => epistemicLabels[es]).filter(Boolean).join(' · ')}. Die Markierungen kennzeichnen Aussageebenen innerhalb des Archivs und sind keine Qualitätsnote.</p>
      </section>

      <footer class="doc-footer">
        <div class="doc-footer-row">
          <span>{signature} · {version}</span>
          <span>overtimearchive.org</span>
          <span>CC BY-NC 4.0</span>
        </div>
        <div class="closing-mark">ᐃ</div>
      </footer>
    </article>
  </div>
</LayoutBase>
