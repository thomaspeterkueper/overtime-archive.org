---
const currentPath = Astro.url.pathname;
const items = [
  { href: '/impressum', label: 'Impressum' },
  { href: '/datenschutz', label: 'Datenschutz' },
  { href: '/nutzungsbedingungen', label: 'Nutzungsbedingungen' },
  { href: '/ki-transparenz', label: 'KI-Transparenz' },
];
---
<nav class="legal-nav" aria-label="Rechtliche Dokumente">
  {items.map(item => <a href={item.href} class:list={[{ active: currentPath === item.href }]}>{item.label}</a>)}
</nav>
<style>
.legal-nav{display:flex;gap:.35rem;flex-wrap:wrap;margin:0 0 1.5rem;font-family:var(--font-mono)}
.legal-nav a{font-size:.62rem;letter-spacing:.06em;color:#465b69;text-decoration:none;background:#f1f5f7;padding:.38rem .62rem;border-bottom:1px solid #cad5dc}
.legal-nav a:hover{color:#244f6b;background:#e7eef2;border-bottom-color:#7899ad}
.legal-nav a.active{color:#244f6b;background:#e3edf2;border-bottom-color:#356b91}
@media(max-width:560px){.legal-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem}.legal-nav a{text-align:center;font-size:.57rem;padding:.42rem .35rem}}
</style>
