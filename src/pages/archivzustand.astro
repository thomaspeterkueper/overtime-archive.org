---
import LayoutBase from '../layouts/LayoutBase.astro';
import qualityIndex from '../data/archive-quality.generated.json';

const docs = qualityIndex.documents as Array<any>;
const summary = qualityIndex.summary as any;
const labels: Record<string,string> = {
  SUBSTANZIELL: 'SUBSTANZIELL',
  KURZ: 'KURZ',
  FRAGMENT: 'FRAGMENT',
};
const flagLabels: Record<string,string> = {
  GENERIC_TITLE: 'Titel generisch',
  GENERIC_SUMMARY: 'Summary generisch',
  RELATION_GAP: 'Relationen fehlen im Frontmatter',
  NO_VISUAL: 'kein Visual',
  NO_HEADINGS: 'keine Überschriften',
  LOW_SUBSTANCE: 'geringer Textumfang',
};
---

<LayoutBase title="Archivzustand">
  <section class="catalog-section" style="max-width:1200px;margin:0 auto;padding-top:2.5rem;padding-bottom:4rem">
    <div style="font-family:var(--font-mono);font-size:0.62rem;color:var(--rust);letter-spacing:0.18em;margin-bottom:0.7rem">OTA · REDAKTIONELLE DIAGNOSTIK</div>
    <h1 style="font-family:var(--font-display);font-size:2.2rem;line-height:1.1;margin-bottom:0.8rem">Archivzustand</h1>
    <p style="font-family:var(--font-serif);font-size:1rem;line-height:1.65;color:var(--ink-light);max-width:78ch">Automatisch erzeugte Arbeitsansicht. Sie verändert keine kanonischen Dokumente. Die Einstufung basiert auf Strukturmerkmalen wie Textumfang, Überschriften, Summary- und Titelqualität sowie dokumentierten Beziehungen und dient ausschließlich der redaktionellen Priorisierung.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.8rem;margin:1.8rem 0 2.4rem">
      <div class="quality-stat"><strong>{summary.documents}</strong><span>Dokumente</span></div>
      <div class="quality-stat"><strong>{summary.substantial}</strong><span>substanziell</span></div>
      <div class="quality-stat"><strong>{summary.short}</strong><span>kurz</span></div>
      <div class="quality-stat"><strong>{summary.fragments}</strong><span>Fragmente</span></div>
      <div class="quality-stat"><strong>{summary.genericTitles}</strong><span>generische Titel</span></div>
      <div class="quality-stat"><strong>{summary.genericSummaries}</strong><span>generische Summary</span></div>
      <div class="quality-stat"><strong>{summary.relationGaps}</strong><span>Relationslücken</span></div>
    </div>

    <div style="display:flex;gap:0.6rem;flex-wrap:wrap;margin-bottom:1.2rem">
      <button class="quality-filter active" data-filter="ALL">ALLE</button>
      <button class="quality-filter" data-filter="FRAGMENT">FRAGMENTE</button>
      <button class="quality-filter" data-filter="GENERIC_TITLE">TITEL PRÜFEN</button>
      <button class="quality-filter" data-filter="GENERIC_SUMMARY">SUMMARY PRÜFEN</button>
      <button class="quality-filter" data-filter="RELATION_GAP">RELATIONEN PRÜFEN</button>
    </div>

    <div style="overflow-x:auto">
      <table class="document-table active quality-table" style="width:100%">
        <thead><tr><th>DOKUMENT</th><th>SUBSTANZ</th><th>WÖRTER</th><th>STRUKTUR</th><th>EXTRAHIERTE HINWEISE</th><th>PRÜFPUNKTE</th></tr></thead>
        <tbody>
          {docs.map(doc => (
            <tr data-substance={doc.quality.substance} data-flags={(doc.quality.flags ?? []).join(' ')}>
              <td style="min-width:220px">
                <a href={`/dokument/${doc.file.replace(/\.(?:md|mdx)$/i,'').toLowerCase()}`} class="table-link">
                  <span class="sig" style="display:block;color:var(--blue-light)">{doc.signature}</span>
                  <span style="display:block;font-family:var(--font-serif);font-size:0.82rem;margin-top:0.2rem">{doc.canonical.title}</span>
                </a>
              </td>
              <td><span class={`quality-badge ${doc.quality.substance.toLowerCase()}`}>{labels[doc.quality.substance] ?? doc.quality.substance}</span></td>
              <td>{doc.metrics.words}</td>
              <td style="white-space:nowrap">{doc.metrics.headings} H · {doc.metrics.images} V · {doc.metrics.inlineReferenceTargets} R</td>
              <td style="min-width:260px">
                {doc.extracted.title && <div><strong>Titel:</strong> {doc.extracted.title}</div>}
                {doc.extracted.author && <div><strong>Autor:</strong> {doc.extracted.author}</div>}
                {doc.extracted.classification && <div><strong>Typ:</strong> {doc.extracted.classification}</div>}
                {!doc.extracted.title && !doc.extracted.author && !doc.extracted.classification && <span style="color:var(--ink-faint)">keine strukturierten Hinweise extrahiert</span>}
              </td>
              <td style="min-width:260px">
                {(doc.quality.flags ?? []).map((flag: string) => <span class="quality-flag">{flagLabels[flag] ?? flag}</span>)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <style>
    .quality-stat{background:var(--paper);border:1px solid rgba(44,36,22,.1);padding:1rem;display:flex;flex-direction:column;gap:.2rem}.quality-stat strong{font-family:var(--font-display);font-size:1.6rem}.quality-stat span{font-family:var(--font-mono);font-size:.58rem;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.1em}.quality-filter{font-family:var(--font-mono);font-size:.6rem;letter-spacing:.08em;padding:.45rem .7rem;border:1px solid rgba(44,36,22,.16);background:var(--paper);color:var(--ink-light);cursor:pointer}.quality-filter.active,.quality-filter:hover{border-color:var(--rust);color:var(--rust);background:rgba(139,69,19,.04)}.quality-badge{font-family:var(--font-mono);font-size:.58rem;padding:.18rem .35rem;border:1px solid rgba(44,36,22,.15)}.quality-badge.substanziell{color:var(--green-term);border-color:rgba(61,122,90,.25)}.quality-badge.kurz{color:var(--amber-term);border-color:rgba(200,146,58,.3)}.quality-badge.fragment{color:var(--red-ink);border-color:rgba(176,48,42,.25)}.quality-flag{display:inline-block;font-family:var(--font-mono);font-size:.54rem;margin:.12rem .18rem .12rem 0;padding:.12rem .3rem;background:rgba(139,69,19,.05);border:1px solid rgba(139,69,19,.12);color:var(--ink-light)}
  </style>

  <script>
    const buttons = Array.from(document.querySelectorAll('.quality-filter'));
    const rows = Array.from(document.querySelectorAll('.quality-table tbody tr'));
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') || 'ALL';
      buttons.forEach(item => item.classList.toggle('active', item === button));
      rows.forEach(row => {
        const substance = row.getAttribute('data-substance') || '';
        const flags = row.getAttribute('data-flags') || '';
        const visible = filter === 'ALL' || substance === filter || flags.split(' ').includes(filter);
        row.style.display = visible ? '' : 'none';
      });
    }));
  </script>
</LayoutBase>
