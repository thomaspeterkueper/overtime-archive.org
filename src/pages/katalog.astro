---
import LayoutBase from '../layouts/LayoutBase.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('documents');
allDocs.sort((a, b) => b.data.year - a.data.year);

const series = [...new Set(allDocs.map(d => d.data.series))].sort();
---

<LayoutBase title="Katalog">
  <section class="catalog-section" style="margin-top:2rem">

    <div style="margin-bottom:1.5rem;position:relative">
      <input type="search" id="catalog-search" placeholder="Schnellsuche im Katalog…"
        style="width:100%;padding:0.6rem 1rem 0.6rem 2.2rem;font-family:var(--font-mono);font-size:0.78rem;background:var(--paper);border:1px solid var(--paper-dark);color:var(--ink);outline:none;box-sizing:border-box"/>
      <span style="position:absolute;left:0.7rem;top:50%;transform:translateY(-50%);color:var(--rust);font-size:0.85rem">⌕</span>
      <a href="/suche" style="position:absolute;right:0.7rem;top:50%;transform:translateY(-50%);font-family:var(--font-mono);font-size:0.55rem;color:var(--rust);text-decoration:none">ERWEITERTE SUCHE →</a>
    </div>

    <div class="catalog-header">
      <h1 style="font-family:var(--font-display);font-size:2rem;color:var(--ink);font-weight:700">Dokumentenkatalog</h1>
      <div class="view-toggle">
        <button class="view-btn active" id="btn-cards">[KARTEN]</button>
        <button class="view-btn" id="btn-ascii">[ASCII]</button>
      </div>
    </div>

    <div class="series-filters">
      <button class="series-btn active" data-series="ALL">ALLE</button>
      {series.map(s => <button class="series-btn" data-series={s}>OTA-{s}</button>)}
    </div>

    <div class="document-grid active" id="view-cards">
      {allDocs.map(doc => (
        <DocumentCard
          signature={doc.data.signature}
          title={doc.data.title}
          summary={doc.data.summary}
          series={doc.data.series}
          year={doc.data.year}
          language={doc.data.language}
          epistemicStatus={doc.data.epistemicStatus}
          accessLevel={doc.data.accessLevel}
          status={doc.data.status}
          slug={doc.slug}
          redacted={doc.data.redacted ?? false}
          data-series={doc.data.series}
        />
      ))}
    </div>

    <table class="document-table" id="view-ascii">
      <thead><tr><th>SIGNATUR</th><th>TITEL</th><th>SERIE</th><th>JAHR</th><th>EPISTEMIC</th><th>STATUS</th><th>ZUGANG</th></tr></thead>
      <tbody>
        {allDocs.map(doc => (
          <tr data-series={doc.data.series}>
            <td class="sig">{doc.data.redacted ? <span style="color:var(--red-faint)">{doc.data.signature}</span> : <a href={`/dokument/${doc.slug}`} class="table-link">{doc.data.signature}</a>}</td>
            <td>{doc.data.redacted ? <span style="color:var(--red-faint)">[GESPERRT]</span> : <a href={`/dokument/${doc.slug}`} class="table-link">{doc.data.title}</a>}</td>
            <td style="color:var(--rust-faint)">{doc.data.series}</td>
            <td>{doc.data.year}</td>
            <td style="color:var(--ink-faint)">{doc.data.epistemicStatus.map(e => `[${e}]`).join(' ')}</td>
            <td class={doc.data.status === 'AKTIV' ? 'status-ok' : doc.data.status === 'GESPERRT' ? 'status-red' : 'status-amr'}>{doc.data.status}</td>
            <td style="color:var(--ink-faint)">{doc.data.accessLevel === 0 ? 'PUBLIC' : `TIER-${doc.data.accessLevel}`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</LayoutBase>

<script>
  const btnCards = document.getElementById('btn-cards');
  const btnAscii = document.getElementById('btn-ascii');
  const viewCards = document.getElementById('view-cards');
  const viewAscii = document.getElementById('view-ascii');

  btnCards?.addEventListener('click', () => {
    viewCards?.classList.add('active'); viewCards?.classList.remove('hidden'); viewAscii?.classList.remove('active');
    btnCards.classList.add('active'); btnAscii?.classList.remove('active');
  });
  btnAscii?.addEventListener('click', () => {
    viewAscii?.classList.add('active'); viewCards?.classList.add('hidden'); viewCards?.classList.remove('active');
    btnAscii.classList.add('active'); btnCards?.classList.remove('active');
  });

  function applySeriesFilter(series) {
    document.querySelectorAll('.series-btn').forEach(b => b.classList.toggle('active', b.getAttribute('data-series') === series));
    document.querySelectorAll('#view-cards [data-series]').forEach(card => {
      card.style.display = (!series || series === 'ALL' || card.getAttribute('data-series') === series) ? '' : 'none';
    });
    document.querySelectorAll('#view-ascii tr[data-series]').forEach(row => {
      row.style.display = (!series || series === 'ALL' || row.getAttribute('data-series') === series) ? '' : 'none';
    });
  }

  document.querySelectorAll('.series-btn').forEach(btn => btn.addEventListener('click', () => {
    const selected = btn.getAttribute('data-series') || 'ALL';
    applySeriesFilter(selected);
    const url = new URL(window.location.href);
    if (selected === 'ALL') url.searchParams.delete('serie'); else url.searchParams.set('serie', selected);
    history.replaceState({}, '', url);
  }));

  const initialSeries = new URLSearchParams(window.location.search).get('serie') || 'ALL';
  applySeriesFilter(initialSeries);

  document.getElementById('catalog-search')?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('#view-cards [data-series]').forEach(card => {
      const text = card.textContent?.toLowerCase() || '';
      if (card.style.display !== 'none' || !q) card.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
    document.querySelectorAll('#view-ascii tr[data-series]').forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      if (row.style.display !== 'none' || !q) row.style.display = (!q || text.includes(q)) ? '' : 'none';
    });
  });
</script>
