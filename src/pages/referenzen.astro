---
import LayoutBase from '../layouts/LayoutBase.astro';
import index from '../data/internal-references.generated.json';

const references = index.references as Array<{
  source: string; target: string; status: string; classification?: string;
  title: string; description: string; descriptionStatus?: string | null;
  contexts: string[]; sourceCount?: number; priority?: number;
  candidates?: Array<{signature:string;title:string;file:string}>;
}>;

const grouped = new Map<string, typeof references>();
for (const ref of references) {
  if (!grouped.has(ref.target)) grouped.set(ref.target, []);
  grouped.get(ref.target)!.push(ref);
}
const targets = [...grouped.entries()];
const unresolved = targets
  .filter(([, refs]) => refs.some(ref => ref.status !== 'resolved'))
  .sort(([, a], [, b]) => (b[0].priority ?? 0) - (a[0].priority ?? 0) || a[0].target.localeCompare(b[0].target));
const counts = index.summary?.classifications ?? {};
const labels: Record<string,string> = {
  missing: 'FEHLT', 'variant-candidate': 'VARIANTE?', planned: 'GEPLANT', uncertain: 'UNKLAR', existing: 'VORHANDEN'
};
---

<LayoutBase title="Referenzregister">
  <section class="catalog-section" style="margin-top:2rem;max-width:1100px">
    <div style="font-family:var(--font-mono);font-size:0.62rem;color:var(--rust);letter-spacing:0.18em;margin-bottom:0.8rem">OTA · REFERENZ-WERKBANK</div>
    <h1 style="font-family:var(--font-display);font-size:2rem;color:var(--ink);margin-bottom:0.6rem">Referenzen</h1>
    <p style="font-family:var(--font-serif);color:var(--ink-light);line-height:1.65;max-width:78ch">
      Das Register erfasst Signaturverweise unabhängig davon, ob das Zieldokument bereits vorliegt. Offene Ziele werden klassifiziert und nach Zahl ihrer unabhängigen Quelldokumente priorisiert. Varianten sind Kandidaten, keine automatische kanonische Zuordnung.
    </p>

    <div style="display:flex;gap:1rem;flex-wrap:wrap;margin:1.5rem 0;font-family:var(--font-mono);font-size:0.65rem">
      <span>{index.documents.length} Dokumente</span><span>{targets.length} referenzierte Ziele</span><span>{unresolved.length} offene Ziele</span>
      <span>{counts.missing ?? 0} fehlen</span><span>{counts['variant-candidate'] ?? 0} Variantenkandidaten</span><span>{counts.planned ?? 0} geplant</span><span>{counts.uncertain ?? 0} unklar</span>
    </div>

    <h2 style="font-family:var(--font-display);font-size:1.35rem;margin:2rem 0 1rem">Priorisierte offene Referenzen</h2>
    <div style="display:grid;gap:0.8rem">
      {unresolved.length === 0 ? <div>Keine offenen Referenzen.</div> : unresolved.map(([target, refs]) => {
        const first = refs[0];
        const sources = [...new Set(refs.map(ref => ref.source))];
        return (
          <article style="border:1px solid var(--paper-dark);background:var(--paper);padding:1rem 1.2rem">
            <div style="display:flex;gap:0.7rem;align-items:baseline;flex-wrap:wrap">
              <span style="font-family:var(--font-mono);font-size:0.68rem;color:var(--rust)">{target}</span>
              <span style="font-family:var(--font-mono);font-size:0.52rem;color:var(--red-faint)">[{labels[first.classification ?? 'missing'] ?? first.classification}]</span>
              <span style="font-family:var(--font-mono);font-size:0.52rem;color:var(--ink-faint)">PRIORITÄT {first.priority ?? sources.length} · {sources.length} QUELLEN</span>
            </div>
            <div style="font-family:var(--font-display);font-size:1rem;color:var(--ink);margin-top:0.3rem">{first.title}</div>
            {first.description && <p style="font-family:var(--font-serif);font-size:0.85rem;color:var(--ink-light);line-height:1.55;margin:0.35rem 0">{first.description}</p>}
            {first.candidates && first.candidates.length > 0 && (
              <div style="margin-top:0.55rem;font-family:var(--font-mono);font-size:0.56rem;color:var(--ink-light)">
                MÖGLICHE VORHANDENE VARIANTE: {first.candidates.map(c => `${c.signature} — ${c.title}`).join(' · ')}
              </div>
            )}
            <div style="font-family:var(--font-mono);font-size:0.54rem;color:var(--ink-faint);margin-top:0.65rem">VERWENDET IN</div>
            <div style="display:flex;gap:0.35rem;flex-wrap:wrap;margin-top:0.3rem">
              {sources.map(source => <span style="font-family:var(--font-mono);font-size:0.56rem;border:1px solid var(--paper-dark);padding:0.12rem 0.35rem">{source}</span>)}
            </div>
            {first.contexts?.[0] && <details style="margin-top:0.7rem"><summary style="font-family:var(--font-mono);font-size:0.54rem;cursor:pointer">BELEGTEXT ANZEIGEN</summary><p style="font-family:var(--font-serif);font-size:0.78rem;line-height:1.5">{first.contexts[0]}</p></details>}
          </article>
        );
      })}
    </div>

    <h2 style="font-family:var(--font-display);font-size:1.35rem;margin:2.5rem 0 1rem">Alle referenzierten Ziele</h2>
    <div style="overflow-x:auto"><table class="document-table active" style="width:100%"><thead><tr><th>ZIEL</th><th>STATUS</th><th>TITEL</th><th>QUELLEN</th></tr></thead><tbody>
      {targets.sort(([a],[b]) => a.localeCompare(b)).map(([target, refs]) => { const first=refs[0]; const sources=[...new Set(refs.map(r=>r.source))]; return <tr><td class="sig">{target}</td><td>{first.status === 'resolved' ? 'vorhanden' : (labels[first.classification ?? 'missing'] ?? first.status)}</td><td>{first.title}</td><td>{sources.length}</td></tr>; })}
    </tbody></table></div>
  </section>
</LayoutBase>
