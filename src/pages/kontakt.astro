---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase title="Kontakt — The Overtime Archive">
  <section class="catalog-section" style="max-width:72ch;margin:3rem auto">
    <div style="font-family:var(--font-mono);font-size:0.62rem;color:var(--rust);letter-spacing:0.2em;margin-bottom:1rem">OTA · KONTAKT</div>
    <h1 style="font-family:var(--font-display);font-size:2rem;color:var(--ink);margin-bottom:0.75rem">Kontakt</h1>
    <p style="font-family:var(--font-serif);color:var(--ink-light);line-height:1.7">
      Verantwortliche und rechtliche Kontaktangaben des OverTime Archive sind im Impressum hinterlegt.
    </p>
    <p style="margin-top:1.5rem">
      <a href="/impressum" style="font-family:var(--font-mono);font-size:0.7rem;color:var(--rust);text-decoration:none">IMPRESSUM & KONTAKTDATEN →</a>
    </p>
  </section>
</LayoutBase>
