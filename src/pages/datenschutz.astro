---
import LayoutBase from '../layouts/LayoutBase.astro';
import LegalDocument from '../components/LegalDocument.astro';
import LegalNav from '../components/LegalNav.astro';
import legal from '../data/legal.generated.json';
---
<LayoutBase title="Datenschutzerklärung">
  <div class="legal-page-shell">
    <div class="legal-kicker">RECHTLICHE ANGABEN · KG LEGAL SSOT</div>
    <LegalNav />
    <LegalDocument title="Datenschutzerklärung" documentId={legal.privacy.id} status={legal.privacy.status} markdown={legal.privacy.markdown} />
  </div>
</LayoutBase>
<style>
.legal-page-shell{max-width:var(--content-width);margin:3rem auto;padding:0 2rem 6rem}.legal-kicker{font-family:var(--font-mono);font-size:.62rem;color:var(--blue);letter-spacing:.2em;margin-bottom:1.2rem}@media(max-width:700px){.legal-page-shell{margin:1.5rem auto;padding:0 1rem 3rem}}
</style>
