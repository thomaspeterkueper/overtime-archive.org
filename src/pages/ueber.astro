---
import LayoutBase from '../layouts/LayoutBase.astro';
import { getCollection } from 'astro:content';
const allDocs = await getCollection('documents');
const seriesCount = new Set(allDocs.map(d => d.data.series)).size;
const years = allDocs.map(d => d.data.year);
const minYear = Math.min(...years); const maxYear = Math.max(...years);
---
<LayoutBase title="Über das Archiv">
  <div class="about-shell">
    <div class="about-kicker">OTA-META · ÜBER DAS ARCHIV</div>
    <h1>Das OverTime Archive</h1>
    <div class="about-panel">
      <p>Das <strong>OverTime Archive</strong> ist ein transmediales Wissenssystem. Es dokumentiert wissenschaftliche Grundlagen, historische Rekonstruktionen, philosophische Fundamente und narrative Strukturen — epistemisch markiert und archivarisch geordnet. Die Zeitspanne reicht von ~60.000 BCE bis 2500 CE.</p>
      <section class="institution-note" aria-labelledby="institution-title">
        <span class="institution-code">IN-WORLD CURATORIAL LAYER</span>
        <h2 id="institution-title">Solar Science Foundation</h2>
        <p>Innerhalb der dargestellten Archivwelt wird das OverTime Archive von der <strong>Solar Science Foundation (SSF)</strong> kuratiert. „Kuratiert“ bezeichnet dabei die institutionelle Erschließung, Klassifikation, Bewahrung und öffentliche Vermittlung der Bestände — nicht deren ursprüngliche Urheberschaft.</p>
        <p class="reality-note"><strong>Reale Ebene:</strong> Das OverTime Archive und die Solar Science Foundation sind Bestandteile eines transmedialen Projekts von Thomas Peter Küper. Die SSF ist in diesem Kontext eine fiktive Institution.</p>
      </section>
      <p>Jedes Dokument trägt explizite epistemologische Marker. Sie trennen reale Quellenlage, Theorie, Hypothese, Spekulation, Fiktion, Werk-Setzung und Interpretation voneinander.</p>
      <div class="stats"><span>ARCHIVSTATISTIK</span><div><b>{allDocs.length}</b> Dokumente online · <b>{seriesCount}</b> Serien · {minYear}–{maxYear} CE · ~62.500 Jahre Zeitspanne</div></div>
      <p class="closing">Das Archiv ist kein abgeschlossenes Werk. Es wächst mit jedem Dokument — und mit jedem, das noch nicht geschrieben ist.</p>
    </div>
  </div>
</LayoutBase>
<style>
.about-shell{max-width:var(--content-width);margin:2.5rem auto;padding:0 2rem 5rem}.about-kicker{font-family:var(--font-mono);font-size:.6rem;color:var(--blue);letter-spacing:.18em;margin-bottom:.8rem}.about-shell h1{font-family:var(--font-display);font-size:2rem;color:var(--ink);margin-bottom:1.5rem}.about-panel{background:var(--paper);border:1px solid var(--paper-dark);padding:2.25rem;font-size:1rem;line-height:1.8}.about-panel p+p{margin-top:1.2rem}.institution-note{margin:1.8rem 0;padding:1.4rem 1.5rem;background:var(--void);border-left:2px solid var(--blue)}.institution-code{font-family:var(--font-mono);font-size:.54rem;letter-spacing:.15em;color:var(--blue)}.institution-note h2{font-family:var(--font-display);font-size:1.25rem;margin:.3rem 0 .7rem}.reality-note{font-size:.9rem;color:var(--ink-light);padding-top:1rem;border-top:1px solid var(--paper-dark)}.stats{margin-top:2rem;padding:1rem 1.2rem;background:var(--void);font-family:var(--font-mono);font-size:.68rem;border:1px solid var(--paper-dark)}.stats>span{display:block;color:var(--blue);letter-spacing:.12em;margin-bottom:.45rem}.stats b{color:var(--blue);font-weight:500}.closing{margin-top:2rem;color:var(--ink-light)}
</style>