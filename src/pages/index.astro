---
import LayoutBase from '../layouts/LayoutBase.astro';
import DocumentCard from '../components/DocumentCard.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('documents');
const totalDocs = allDocs.length;
const seriesSet = new Set(allDocs.map(d => d.data.series));
const restrictedCount = allDocs.filter(d => d.data.accessLevel > 0).length;

const seriesLabels: Record<string, { label: string; desc: string }> = {
  SCI: { label: 'Scientific', desc: 'Wissenschaftliche Grundlagen und referenzierte Forschungsstände' },
  TEC: { label: 'Technical', desc: 'Technische Systeme, Verfahren und Konstruktionsprinzipien' },
  FND: { label: 'Foundation', desc: 'Philosophische und konzeptuelle Fundamente' },
  BIO: { label: 'Biography', desc: 'Personendossiers realer und fiktiver Personen' },
  HIS: { label: 'History', desc: 'Historische Rekonstruktionen und Epochenanalysen' },
  RED: { label: 'Redacted', desc: 'Dokumente mit eingeschränkter Zugangsstufe' },
  ARC: { label: 'Archive', desc: 'Archivrichtlinien und Governance' },
  NAR: { label: 'Narrative', desc: 'Erzähltexte und narrative Dokumente' },
  ORG: { label: 'Organisation', desc: 'Organisationen und Institutionen' },
  OBS: { label: 'Observation', desc: 'Beobachtungen und Feldberichte' },
  LSC: { label: 'Linkage', desc: 'Thematische Verbindungen und Leitmotive' },
  MON: { label: 'Monitor', desc: 'Laufende Beobachtungsdokumente' },
  KOM: { label: 'Communication', desc: 'Kommunikationsdokumente' },
  CUL: { label: 'Culture', desc: 'Kulturelle Objekte, Praktiken und Kontexte' },
  LIM: { label: 'Boundary', desc: 'Grenzfälle und Ausnahmedokumente' },
  LIT: { label: 'Literature', desc: 'Literarische und werkbezogene Dokumente' },
  KARTE: { label: 'Map', desc: 'Kartierungen, Netzwerke und strukturierte Übersichten' },
  META: { label: 'Meta', desc: 'Metadokumente zur Struktur und Methode des Archivs' },
  ART: { label: 'Artifact', desc: 'Artefakt- und Objekt-Dossiers' },
};

const seriesCounts = [...seriesSet].map(code => ({
  code,
  count: allDocs.filter(d => d.data.series === code).length,
  label: seriesLabels[code]?.label ?? code,
  desc: seriesLabels[code]?.desc ?? 'Archivserie',
})).sort((a, b) => b.count - a.count || a.code.localeCompare(b.code));

const featuredSeries = seriesCounts.slice(0, 6);
const archiveSelection = [...allDocs].sort((a, b) => a.data.signature.localeCompare(b.data.signature)).slice(0, 6);
---

<LayoutBase title="The Overtime Archive">
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-grid-lines"></div>
    <div class="hero-content">
      <div class="hero-eyebrow fade-in">Transmedia Archive · Est. 2025 · overtimearchive.org</div>
      <h1 class="hero-title fade-in-delay-1">Das Archiv<br/><em>bewahrt</em>,<br/>was vergessen wird.</h1>
      <p class="hero-subtitle fade-in-delay-2">Ein transmediales Wissenssystem. Wissenschaft, Fiktion, Spekulation — epistemisch markiert, archivarisch dokumentiert, narrativ verankert. 60.000 BCE bis 2500 CE.</p>
      <div class="hero-stats fade-in-delay-3">
        <div class="stat-block"><span class="stat-value">{totalDocs}</span><span class="stat-label">Dokumente</span></div>
        <div class="stat-block"><span class="stat-value">{seriesSet.size}</span><span class="stat-label">Serien</span></div>
        <div class="stat-block"><span class="stat-value">{restrictedCount}</span><span class="stat-label">Gesperrt</span></div>
        <div class="stat-block"><span class="stat-value">~62.500</span><span class="stat-label">Jahre Spanne</span></div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="catalog-section">
    <div class="catalog-header"><div class="catalog-title">Dokumentenserien</div><a href="/serien">Alle {seriesSet.size} Serien →</a></div>
    <div class="home-series-grid">
      {featuredSeries.map(s => (
        <a href={`/katalog?serie=${s.code}`} class="series-card-link">
          <div class="home-series-code">OTA-{s.code}</div>
          <div class="home-series-title">{s.label}</div>
          <div class="home-series-desc">{s.desc}</div>
          <div class="home-series-count">{s.count} Dokument{s.count !== 1 ? 'e' : ''}</div>
        </a>
      ))}
    </div>
  </section>

  <div class="divider"></div>

  <section class="catalog-section">
    <div class="catalog-header"><div class="catalog-title">Archivauswahl</div><a href="/katalog">Alle Dokumente →</a></div>
    <div class="document-grid active">
      {archiveSelection.map(doc => (
        <DocumentCard signature={doc.data.signature} title={doc.data.title} summary={doc.data.summary} series={doc.data.series} year={doc.data.year} language={doc.data.language} epistemicStatus={doc.data.epistemicStatus} accessLevel={doc.data.accessLevel} status={doc.data.status} slug={doc.id} redacted={doc.data.redacted ?? false} />
      ))}
    </div>
  </section>

  <section class="catalog-section" style="max-width:72ch;margin-top:0">
    <div class="kn-block">
      <div class="kn-label">[KN-0.1] — Kuratorische Vorbemerkung</div>
      <div class="kn-text">Das OverTime Archive ist kein Museum. Es ist ein aktives Wissenssystem — transmedialer Anker, wissenschaftliche Datenbank, narratives Fundament. Jedes Dokument trägt einen epistemischen Status. Kein Anspruch bleibt unmarkiert. Das Archiv dokumentiert. Es spekuliert nicht.</div>
      <div class="kn-sig">— T.P.K., OTA-BIO-0000</div>
    </div>
  </section>
</LayoutBase>
