---
import LayoutBase from '../layouts/LayoutBase.astro';
import LegalDocument from '../components/LegalDocument.astro';
import LegalNav from '../components/LegalNav.astro';
import legal from '../data/legal.generated.json';
---
<LayoutBase title="Impressum">
  <div class="legal-page-shell">
    <div class="legal-kicker">RECHTLICHE ANGABEN · KG LEGAL SSOT</div>
    <LegalNav />
    <LegalDocument title="Impressum" documentId={legal.imprint.id} status={legal.imprint.status} imprint={legal.imprint} />
    <section class="ota-disclosures" aria-labelledby="ota-disclosures-title"><div class="ota-disclosures-head"><h2 id="ota-disclosures-title">OTA-spezifische Hinweise</h2><span>REALITY / FICTION DISCLOSURE</span></div><div class="ota-disclosures-body">
      <p><strong>Institutionelle Darstellung</strong></p><p>Die im Interface verwendete Angabe <code>CURATED BY · SOLAR SCIENCE FOUNDATION</code> gehört zur fiktionalen Ebene des transmedialen Archivprojekts. Die Solar Science Foundation (SSF) ist keine reale Betreiberin oder rechtlich verantwortliche Institution dieser Website. Reale Verantwortlichkeiten ergeben sich ausschließlich aus dem vorstehenden Impressum.</p>
      <p><strong>Inhalte</strong></p><p>Das OverTime Archive verbindet reale Wissensbestände mit fiktionalen und narrativen Ebenen. Dokumente mit dem Marker <code>[F]</code> sind fiktive Inhalte. Dokumente mit <code>[R]</code> basieren auf überprüfbaren wissenschaftlichen Quellen, die im jeweiligen Dokument ausgewiesen werden.</p>
      <p><strong>Urheberrecht</strong></p><p>Alle Inhalte dieser Website — Texte, Dokumente, Grafiken und Strukturen — sind urheberrechtlich geschützt. Veröffentlichte Archivdokumente stehen, sofern nicht anders angegeben, unter <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>.</p>
    </div></section>
    <p class="build-source">Build-Quelle: {legal.sourceRepository} · Hosting: {legal.hostingVerified}</p>
  </div>
</LayoutBase>
<style>
.legal-page-shell{max-width:var(--content-width);margin:3rem auto;padding:0 2rem 6rem}.legal-kicker{font-family:var(--font-mono);font-size:.62rem;color:var(--blue);letter-spacing:.2em;margin-bottom:1.2rem}.ota-disclosures{background:var(--paper);color:var(--ink);padding:clamp(1.3rem,4vw,3rem);border:1px solid var(--paper-dark);margin-top:2rem;font-family:var(--font-serif);font-size:1rem;line-height:1.85}.ota-disclosures-head{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;border-bottom:1px solid var(--paper-dark);padding-bottom:.75rem;margin-bottom:1.5rem}.ota-disclosures-head h2{font-family:var(--font-display);font-size:1.3rem;margin:0}.ota-disclosures-head span{font-family:var(--font-mono);font-size:.58rem;letter-spacing:.1em;color:var(--blue)}.ota-disclosures-body p{margin:.7rem 0}.ota-disclosures-body code{font-family:var(--font-mono);font-size:.85em}.ota-disclosures-body a{color:var(--ink-light);text-decoration-color:#c6d0d6;text-underline-offset:4px}.ota-disclosures-body a:hover{color:var(--blue-dim);text-decoration-color:var(--blue-faint)}.build-source{font-family:var(--font-mono);font-size:.62rem;margin-top:1rem;color:var(--ink-faint)}
@media(max-width:700px){.legal-page-shell{margin:1.5rem auto;padding:0 1rem 3rem}}
</style>
